# Citation Validator Pro - Configuration Template
# Copy this file to .env and customize as needed

# =============================================================================
# LLM PROVIDER SETTINGS
# =============================================================================

# Primary LLM Provider (openai, anthropic, local)
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7

# Mock LLM for Testing (set to true to disable API calls)
USE_MOCK_LLM=false

# =============================================================================
# PROCESSING CONFIGURATION
# =============================================================================

# Validation Mode (Simplified, Comprehensive)
MODE=Simplified

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# INPUT/OUTPUT SETTINGS
# =============================================================================

# Input directory containing content.html and footnotes.json
INPUT_DIR=input

# Output directory for generated reports
OUTPUT_DIR=output

# Default output filename (can be overridden via CLI)
OUTPUT_FILE=content_reviewed.html

# =============================================================================
# FUTURE PROVIDER OPTIONS (CURRENTLY UNUSED)
# =============================================================================

# Anthropic Claude Configuration
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# Local LLM Configuration (e.g., Ollama)
# LOCAL_LLM_URL=http://localhost:11434/api/generate
# LOCAL_LLM_MODEL=llama2:7b

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================

# Enable detailed processing logs
# DETAILED_LOGGING=false

# Custom prompt template file
# PROMPT_TEMPLATE_FILE=custom_prompts.json

# Maximum concurrent LLM requests
# MAX_CONCURRENT_REQUESTS=3
